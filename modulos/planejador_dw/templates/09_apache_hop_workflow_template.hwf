<?xml version="1.0" encoding="UTF-8"?>
<workflow>
  <name>wf_carga_${SISTEMA}_${DOMINIO}</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Workflow Apache Hop para orquestracao da ingestao de dados para o Oracle DW</description>
  <extended_description/>
  <workflow_version>1.0</workflow_version>
  <created_user>-</created_user>
  <created_date>2026/10/08 10:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/10/08 10:00:00.000</modified_date>
  <parameters>
  </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description>Inicio do workflow</description>
      <type>SPECIAL</type>
      <attributes/>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <hour>12</hour>
      <minutes>0</minutes>
      <weekDay>1</weekDay>
      <DayOfMonth>1</DayOfMonth>
      <parallel>N</parallel>
      <xloc>80</xloc>
      <yloc>100</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Verifica Conexao Oracle</name>
      <description>Valida conectividade com o schema Oracle DW antes da execucao</description>
      <type>CHECK_DB_CONNECTIONS</type>
      <attributes/>
      <connections>
        <connection>
          <name>${CONEXAO_ORACLE_DW}</name>
          <waitfor>5</waitfor>
          <waittime>millisecond</waittime>
        </connection>
      </connections>
      <parallel>N</parallel>
      <xloc>260</xloc>
      <yloc>100</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Executa Pipeline Staging</name>
      <description>Dispara pipeline de ingestao do arquivo para a tabela STG</description>
      <type>PIPELINE</type>
      <attributes/>
      <filename>${PROJECT_HOME}/pipelines/pipe_stg_${SISTEMA}_${DOMINIO}_${ENTIDADE}.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <set_append_logfile>N</set_append_logfile>
      <create_parent_folder>N</create_parent_folder>
      <run_configuration>local</run_configuration>
      <parameters>
      </parameters>
      <parallel>N</parallel>
      <xloc>460</xloc>
      <yloc>100</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Sucesso</name>
      <description>Finalizacao com sucesso</description>
      <type>SUCCESS</type>
      <attributes/>
      <parallel>N</parallel>
      <xloc>660</xloc>
      <yloc>100</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Verifica Conexao Oracle</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Verifica Conexao Oracle</from>
      <to>Executa Pipeline Staging</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Executa Pipeline Staging</from>
      <to>Sucesso</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
  </notepads>
  <attributes/>
</workflow>

