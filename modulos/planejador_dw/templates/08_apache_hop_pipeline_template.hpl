<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>pipe_stg_<sistema>_<dominio>_<entidade></name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Pipeline Apache Hop de ingestao de arquivo CSV/SFTP para Staging Oracle</description>
    <extended_description/>
    <pipeline_version>1.0</pipeline_version>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/10/08 10:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/10/08 10:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>CSV File Input</from>
      <to>Select &amp; Format Values</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Select &amp; Format Values</from>
      <to>Oracle Staging Table Output</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>CSV File Input</name>
    <type>CSVInput</type>
    <description>Leitura do arquivo delimitado na pasta de entrada</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <filename>${PROJECT_HOME}/entrada/<ARQUIVO_ENTRADA>.csv</filename>
    <filename_field/>
    <rownum_field/>
    <include_filename>N</include_filename>
    <separator>;</separator>
    <enclosure>&quot;</enclosure>
    <header>Y</header>
    <buffer_size>50000</buffer_size>
    <lazy_conversion>N</lazy_conversion>
    <add_filename_result>N</add_filename_result>
    <parallel>N</parallel>
    <newline_possible>N</newline_possible>
    <encoding>UTF-8</encoding>
    <fields>
      <field>
        <name>id_origem</name>
        <type>Integer</type>
        <format>#</format>
        <currency/>
        <decimal/>
        <group/>
        <length>38</length>
        <precision>0</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>data_evento</name>
        <type>Date</type>
        <format>yyyy-MM-dd HH:mm:ss</format>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>codigo_entidade</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>50</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>descricao</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>255</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>valor_total</name>
        <type>Number</type>
        <format>#.#</format>
        <currency/>
        <decimal>.</decimal>
        <group>,</group>
        <length>18</length>
        <precision>4</precision>
        <trim_type>both</trim_type>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>120</xloc>
      <yloc>120</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Select &amp; Format Values</name>
    <type>SelectValues</type>
    <description>Padronizacao de nomes para MAIUSCULAS e tipos Oracle</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>id_origem</name>
        <rename>ID_<ENTIDADE></rename>
      </field>
      <field>
        <name>data_evento</name>
        <rename>DATA_<EVENTO></rename>
      </field>
      <field>
        <name>codigo_entidade</name>
        <rename>SIGLA_<ENTIDADE></rename>
      </field>
      <field>
        <name>descricao</name>
        <rename>NOME_<ENTIDADE></rename>
      </field>
      <field>
        <name>valor_total</name>
        <rename>VAL_<VALOR_1></rename>
      </field>
      <select_unspecified>N</select_unspecified>
    </fields>
    <attributes/>
    <GUI>
      <xloc>320</xloc>
      <yloc>120</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Oracle Staging Table Output</name>
    <type>InsertUpdate</type>
    <description>Gravacao idempotente na tabela STG do Oracle</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection><CONEXAO_ORACLE_DW></connection>
    <commit>1000</commit>
    <update_bypassed>N</update_bypassed>
    <lookup>
      <schema><SCHEMA_ALVO></schema>
      <table>STG_<SISTEMA>_<DOMINIO>_<ENTIDADE></table>
      <key>
        <name>ID_<ENTIDADE></name>
        <field>ID_<ENTIDADE></field>
        <condition>=</condition>
        <name2/>
      </key>
      <value>
        <name>ID_<ENTIDADE></name>
        <rename>ID_<ENTIDADE></rename>
        <update>Y</update>
      </value>
      <value>
        <name>DATA_<EVENTO></name>
        <rename>DATA_<EVENTO></rename>
        <update>Y</update>
      </value>
      <value>
        <name>SIGLA_<ENTIDADE></name>
        <rename>SIGLA_<ENTIDADE></rename>
        <update>Y</update>
      </value>
      <value>
        <name>NOME_<ENTIDADE></name>
        <rename>NOME_<ENTIDADE></rename>
        <update>Y</update>
      </value>
      <value>
        <name>VAL_<VALOR_1></name>
        <rename>VAL_<VALOR_1></rename>
        <update>Y</update>
      </value>
    </lookup>
    <attributes/>
    <GUI>
      <xloc>520</xloc>
      <yloc>120</yloc>
    </GUI>
  </transform>
</pipeline>

