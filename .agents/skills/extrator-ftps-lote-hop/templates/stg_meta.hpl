<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>-1</pipeline_status>
    <parameters/>
    <name>stg_meta</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/10/05 10:24:56.911</created_date>
    <modified_date>2026/10/05 10:24:56.911</modified_date>
  </info>
  <transform>
    <type>CSVInput</type>
    <name>Ler Manifesto FTPS</name>
    <filename>${ENV_DIR_DEST}/arquivos_ftps_${HOP_PROJECT_NAME}.csv</filename>
    <include_filename>N</include_filename>
    <rownum_field/>
    <header>Y</header>
    <separator>;</separator>
    <enclosure>"</enclosure>
    <buffer_size>50000</buffer_size>
    <lazy_conversion>N</lazy_conversion>
    <add_filename_result>N</add_filename_result>
    <parallel>N</parallel>
    <encoding>UTF-8</encoding>
    <newline_possible>N</newline_possible>
    <schemaDefinition/>
    <ignoreFields>N</ignoreFields>
    <fields>
      <field>
        <name>NOME_PROJETO</name>
        <length>50</length>
        <type>String</type>
        <format/>
        <trim_type>none</trim_type>
        <precision>-1</precision>
        <currency>$</currency>
        <decimal>.</decimal>
        <group>,</group>
      </field>
      <field>
        <name>NOME_ARQUIVO</name>
        <length>255</length>
        <type>String</type>
        <format/>
        <trim_type>none</trim_type>
        <precision>-1</precision>
        <currency>$</currency>
        <decimal>.</decimal>
        <group>,</group>
      </field>
      <field>
        <name>DATA_MODIFICACAO</name>
        <length>-1</length>
        <type>Date</type>
        <format>yyyy-MM-dd HH:mm:ss</format>
        <trim_type>none</trim_type>
        <precision>-1</precision>
        <currency>$</currency>
        <decimal>.</decimal>
        <group>,</group>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>256</xloc>
      <yloc>144</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>SampleRows</type>
    <name>Filtrar Cabecalho/Amostra</name>
    <linesrange>1-1000000</linesrange>
    <linenumfield/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>400</xloc>
      <yloc>144</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>InsertUpdate</type>
    <name>Upsert STG Controle FTPS</name>
    <lookup>
      <key>
        <name>NOME_PROJETO</name>
        <field>NOME_PROJETO</field>
        <condition>=</condition>
        <name2/>
      </key>
      <key>
        <name>NOME_ARQUIVO</name>
        <field>NOME_ARQUIVO</field>
        <condition>=</condition>
        <name2/>
      </key>
      <value>
        <name>NOME_PROJETO</name>
        <rename>NOME_PROJETO</rename>
        <update>Y</update>
      </value>
      <value>
        <name>NOME_ARQUIVO</name>
        <rename>NOME_ARQUIVO</rename>
        <update>Y</update>
      </value>
      <value>
        <name>DATA_MODIFICACAO</name>
        <rename>DATA_MODIFICACAO</rename>
        <update>Y</update>
      </value>
      <schema>${DB_DW_OWNER}</schema>
      <table>STG_CONTROLE_ARQUIVOS_FTPS</table>
    </lookup>
    <commit>100</commit>
    <update_bypassed>N</update_bypassed>
    <connection>${DB_CONNECTION_NAME}</connection>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>560</xloc>
      <yloc>144</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <order>
    <hop>
      <from>Ler Manifesto FTPS</from>
      <to>Filtrar Cabecalho/Amostra</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Filtrar Cabecalho/Amostra</from>
      <to>Upsert STG Controle FTPS</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <notepads/>
  <attributes/>
  <transform_error_handling/>
</pipeline>
