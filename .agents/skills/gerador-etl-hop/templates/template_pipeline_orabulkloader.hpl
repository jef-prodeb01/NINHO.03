<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>ppl_stg_orabulkloader_template</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Template de Alta Volumetria Apache Hop 2.x — Oracle Bulk Loader (SQL*Loader DIRECT=TRUE + AUTO_CONCURRENT)</description>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
      <parameter>
        <name>PRM_LOTE_EXTRACAO</name>
        <default_value>SYSDATE</default_value>
        <description>Data/hora de referência do lote de extração</description>
      </parameter>
    </parameters>
  </info>
  <notepads>
    <notepad>
      <note>Padrão NINHO / PRODEB — Ingestão de Alta Volumetria (&gt; 1 milhão de linhas)
Utiliza OraBulkLoader (SQL*Loader nativo com DIRECT=TRUE e AUTO_CONCURRENT)
para bypassar o buffer cache transacional do Oracle em tabelas STG_* NOLOGGING.</note>
      <xloc>80</xloc>
      <yloc>32</yloc>
      <width>560</width>
      <heigth>72</heigth>
    </notepad>
  </notepads>
  <order>
    <hop>
      <from>IN_FONTE_ALTA_VOLUMETRIA</from>
      <to>META_PADRONIZAR_TIPOS</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>META_PADRONIZAR_TIPOS</from>
      <to>BULK_STG_ALVO</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>IN_FONTE_ALTA_VOLUMETRIA</name>
    <type>TableInput</type>
    <connection>ORACLE_ORIGEM</connection>
    <sql>SELECT COD_REGISTRO, DES_EVENTO, VAL_MOVIMENTO, DTC_MOVIMENTO FROM ${ENV_DB_SCHEMA_ORIGEM}.TB_FONTE_EVENTO</sql>
    <limit>0</limit>
    <replace_variables>N</replace_variables>
    <gui>
      <xloc>120</xloc>
      <yloc>176</yloc>
    </gui>
  </transform>
  <transform>
    <name>META_PADRONIZAR_TIPOS</name>
    <type>SelectValues</type>
    <fields>
      <select_unspecified>N</select_unspecified>
    </fields>
    <gui>
      <xloc>368</xloc>
      <yloc>176</yloc>
    </gui>
  </transform>
  <transform>
    <name>BULK_STG_ALVO</name>
    <type>OraBulkLoader</type>
    <connection>ORACLE_STG</connection>
    <schema>${ENV_DB_SCHEMA_STG}</schema>
    <table>STG_EVENTO_VOLUMOSO</table>
    <sqlldr>${ENV_SQLPLUS_BIN}</sqlldr>
    <control_file>${java.io.tmpdir}/stg_evento_${Internal.Pipeline.Run.Id}.ctl</control_file>
    <data_file>${java.io.tmpdir}/stg_evento_${Internal.Pipeline.Run.Id}.dat</data_file>
    <log_file>${java.io.tmpdir}/stg_evento_${Internal.Pipeline.Run.Id}.log</log_file>
    <bad_file>${java.io.tmpdir}/stg_evento_${Internal.Pipeline.Run.Id}.bad</bad_file>
    <discard_file>${java.io.tmpdir}/stg_evento_${Internal.Pipeline.Run.Id}.dsc</discard_file>
    <load_method>AUTO_CONCURRENT</load_method>
    <load_action>TRUNCATE</load_action>
    <direct_path>Y</direct_path>
    <erase_files>Y</erase_files>
    <encoding>UTF-8</encoding>
    <max_errors>0</max_errors>
    <commit>100000</commit>
    <bind_size>0</bind_size>
    <read_size>0</read_size>
    <fail_on_warning>N</fail_on_warning>
    <fail_on_error>Y</fail_on_error>
    <parallel>Y</parallel>
    <gui>
      <xloc>624</xloc>
      <yloc>176</yloc>
    </gui>
  </transform>
</pipeline>

